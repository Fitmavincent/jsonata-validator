{
  "name": "jsonata-validator",
  "publisher": "Fitmavincent",
  "displayName": "jsonata-validator",
  "description": "A jsonata validator extention that can validate jsonata template",
  "icon": "media/icon.png",
  "version": "1.6.1",
  "pricing": "Free",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Extension Packs",
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:jsonata"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fitmavincent/jsonata-validator.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "jsonata",
        "aliases": [
          "JSONata",
          "jsonata"
        ],
        "extensions": [
          ".jsonata"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonata-result",
        "aliases": [
          "JSONata Result"
        ]
      }
    ],
    "commands": [
      {
        "command": "jsonata-validator.validateDocument",
        "title": "Validate JSONata Document",
        "category": "JSONata"
      },
      {
        "command": "jsonata-validator.validateSelection",
        "title": "Validate JSONata Selection",
        "category": "JSONata"
      },
      {
        "command": "jsonata-validator.openPlayground",
        "title": "Open JSONata Playground",
        "category": "JSONata",
        "icon": "$(play)"
      },
      {
        "command": "jsonata-validator.openPlaygroundWithSelection",
        "title": "Open JSONata Playground with Selection",
        "category": "JSONata",
        "icon": "$(play)"
      },
      {
        "command": "jsonata-validator.populatePlaygroundFromActiveEditor",
        "title": "Populate Playground from Active Editor",
        "category": "JSONata",
        "icon": "$(arrow-right)"
      },
      {
        "command": "jsonata-validator.sharePlaygroundSession",
        "title": "Share JSONata Playground Session",
        "category": "JSONata",
        "icon": "$(share)"
      },
      {
        "command": "jsonata-validator.importPlaygroundSession",
        "title": "Import JSONata Playground Session",
        "category": "JSONata",
        "icon": "$(cloud-download)"
      },
      {
        "command": "jsonata-validator.exportPlaygroundToClipboard",
        "title": "Export Playground Session to Clipboard",
        "category": "JSONata",
        "icon": "$(clippy)"
      },
      {
        "command": "jsonata-validator.importPlaygroundFromClipboard",
        "title": "Import Playground Session from Clipboard",
        "category": "JSONata",
        "icon": "$(clippy)"
      },
      {
        "command": "jsonata-validator.refreshPlaygroundResult",
        "title": "Refresh JSONata Playground Result",
        "category": "JSONata",
        "icon": "$(refresh)"
      },
      {
        "command": "jsonata-validator.selectPlaygroundSources",
        "title": "Select JSONata Playground Sources",
        "category": "JSONata",
        "icon": "$(list-selection)"
      },
      {
        "command": "jsonata-validator.selectPlaygroundInputSource",
        "title": "Select JSONata Playground JSON Input Source",
        "category": "JSONata",
        "icon": "$(json)"
      },
      {
        "command": "jsonata-validator.selectPlaygroundTemplateSource",
        "title": "Select JSONata Playground Expression Source",
        "category": "JSONata",
        "icon": "$(file-code)"
      },
      {
        "command": "jsonata-validator.copyPlaygroundResult",
        "title": "Copy JSONata Playground Result",
        "category": "JSONata",
        "icon": "$(copy)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "jsonataPlayground",
          "title": "JSONata Playground",
          "icon": "$(json)"
        }
      ]
    },
    "views": {
      "jsonataPlayground": [
        {
          "id": "jsonataPlaygroundSources",
          "name": "Sources",
          "type": "webview",
          "when": "jsonataValidator.playgroundOpen"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .jsonata",
          "command": "jsonata-validator.validateDocument",
          "group": "jsonata"
        },
        {
          "when": "editorHasSelection && resourceExtname == .jsonata",
          "command": "jsonata-validator.validateSelection",
          "group": "jsonata"
        },
        {
          "when": "resourceExtname == .jsonata",
          "command": "jsonata-validator.openPlayground",
          "group": "jsonata"
        },
        {
          "when": "editorHasSelection && resourceExtname == .jsonata",
          "command": "jsonata-validator.openPlaygroundWithSelection",
          "group": "jsonata"
        },
        {
          "command": "jsonata-validator.populatePlaygroundFromActiveEditor",
          "group": "jsonata"
        },
        {
          "command": "jsonata-validator.sharePlaygroundSession",
          "group": "jsonata"
        },
        {
          "command": "jsonata-validator.importPlaygroundSession",
          "group": "jsonata"
        }
      ],
      "commandPalette": [
        {
          "command": "jsonata-validator.openPlayground"
        },
        {
          "command": "jsonata-validator.openPlaygroundWithSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "jsonata-validator.populatePlaygroundFromActiveEditor"
        },
        {
          "command": "jsonata-validator.sharePlaygroundSession"
        },
        {
          "command": "jsonata-validator.importPlaygroundSession"
        },
        {
          "command": "jsonata-validator.exportPlaygroundToClipboard"
        },
        {
          "command": "jsonata-validator.importPlaygroundFromClipboard"
        },
        {
          "command": "jsonata-validator.refreshPlaygroundResult"
        },
        {
          "command": "jsonata-validator.selectPlaygroundSources"
        },
        {
          "command": "jsonata-validator.selectPlaygroundInputSource"
        },
        {
          "command": "jsonata-validator.selectPlaygroundTemplateSource"
        },
        {
          "command": "jsonata-validator.copyPlaygroundResult"
        }
      ],
      "editor/title": [
        {
          "command": "jsonata-validator.copyPlaygroundResult",
          "when": "resourceScheme == jsonata-result",
          "group": "navigation@1"
        },
        {
          "command": "jsonata-validator.refreshPlaygroundResult",
          "when": "resourceScheme == jsonata-result",
          "group": "navigation@2"
        },
        {
          "command": "jsonata-validator.selectPlaygroundSources",
          "when": "resourceScheme == jsonata-result",
          "group": "navigation@3"
        },
        {
          "command": "jsonata-validator.sharePlaygroundSession",
          "when": "resourceScheme == jsonata-result",
          "group": "1_playground@1"
        },
        {
          "command": "jsonata-validator.importPlaygroundSession",
          "when": "resourceScheme == jsonata-result",
          "group": "1_playground@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "JSONata Validator",
      "properties": {
        "jsonataValidator.validateOnType": {
          "type": "boolean",
          "default": true,
          "description": "Validate JSONata expressions as you type"
        },
        "jsonataValidator.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate JSONata expressions when saving files"
        },
        "jsonataValidator.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems to report"
        },
        "jsonataValidator.warnOnUnsupportedLineComments": {
          "type": "boolean",
          "default": true,
          "description": "Warn about '//' comments, which JSONata does not support. JSONata only understands block comments: /* ... */"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "jsonata": "^2.0.6"
  }
}
